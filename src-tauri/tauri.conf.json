{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SolutionsPDF",
  "version": "0.1.2",
  "identifier": "com.solutionspdf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SolutionsPDF | Gestión inteligente de documentos",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Documento PDF",
        "description": "Documento PDF",
        "mimeType": "application/pdf"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyNTBCRjY4ODNFMTU5MEQKUldRTldlR0RhTDlRQXQvOVU3bTd6L2FzMituYmtZNXVBeDZmMUV4ZnR0U0tEc3RYQkIvaVkxQ28K",
      "endpoints": [
        "https://github.com/AndresRodriguez991114/SolutionPDF/releases/latest/download/latest.json"
      ]
    }
  }
}
